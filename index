
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#f8f3e9">
<title>Lễ Hằng Thuận | Matteo & Hoà</title>
<style>
:root{
  --cream:#f8f3e9;
  --olive:#62694d;
  --gold:#b79b6c;
  --pink:#e6b9b0;
}
*{box-sizing:border-box}
body{
  margin:0;
  background:#eae5dc;
  font-family:Georgia,"Times New Roman",serif;
  color:var(--olive);
}
main{
  min-height:100svh;
  display:grid;
  place-items:center;
  padding:15px;
}
.card{
  position:relative;
  width:min(100%,440px);
  height:min(820px,92svh);
  min-height:560px;
  overflow:hidden;
  background:
    radial-gradient(ellipse at 55% 35%,
      #fffdf8,var(--cream) 80%);
  box-shadow:0 20px 70px #64563c30;
  border:1px solid #e4d9c8;
  border-radius:8px;
  isolation:isolate;
}
.scene{
  position:absolute;
  inset:0;
  transition:opacity 1.4s ease,
    transform 1.4s ease;
}
.cover{z-index:2}
.details{
  z-index:1;
  opacity:0;
  transform:scale(1.06);
}
.card.open .cover{
  opacity:0;
  transform:scale(1.1);
  pointer-events:none;
}
.card.open .details{
  opacity:1;
  transform:scale(1);
}
.art{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  pointer-events:none;
}
.branch{
  transform-origin:0 0;
  animation:sway 7s ease-in-out infinite alternate;
}
.lantern{
  transform-origin:78px 0;
  animation:swing 5s ease-in-out infinite alternate;
}
@keyframes sway{
  to{transform:rotate(3deg)}
}
@keyframes swing{
  to{transform:rotate(6deg)}
}
@keyframes float{
  0%{transform:translateY(-40px) rotate(0)}
  100%{transform:translateY(850px) rotate(360deg)}
}
.petals{
  position:absolute;
  inset:0;
  pointer-events:none;
  overflow:hidden;
}
.petal{
  position:absolute;
  top:-30px;
  width:10px;
  height:7px;
  background:#e7b8b1;
  border-radius:80% 0 80% 0;
  opacity:.65;
  animation:float linear infinite;
}
.header{
  position:absolute;
  top:23%;
  width:100%;
  text-align:center;
  z-index:3;
}
.eyebrow{
  font-size:11px;
  letter-spacing:4px;
  margin-bottom:17px;
}
.heading{
  font-size:clamp(24px,6.3vw,35px);
  font-weight:400;
  letter-spacing:4px;
  margin:0;
}
.ornament{
  margin-top:14px;
  font-size:16px;
  color:var(--gold);
}
.names{
  position:absolute;
  bottom:15%;
  width:100%;
  text-align:center;
  z-index:3;
  font-size:clamp(23px,6vw,32px);
  letter-spacing:2px;
  text-shadow:0 2px 12px #fff;
}
.names span{color:var(--gold)}
.open-button{
  position:absolute;
  bottom:6%;
  left:50%;
  transform:translateX(-50%);
  z-index:5;
}
button{
  cursor:pointer;
  border:1px solid var(--gold);
  background:var(--olive);
  color:#fffaf0;
  padding:13px 28px;
  border-radius:30px;
  font-family:Georgia,serif;
  letter-spacing:1px;
  font-size:13px;
  transition:background .3s,transform .3s;
  white-space:nowrap;
}
button:hover{background:#838969}
.detail-content{
  position:absolute;
  z-index:3;
  top:24%;
  width:100%;
  text-align:center;
  padding:0 26px;
}
.detail-content h2{
  font-weight:400;
  font-size:27px;
  letter-spacing:3px;
  margin:0 0 12px;
}
.subtitle{
  font-size:12px;
  letter-spacing:2px;
  line-height:1.8;
}
.divider{
  color:var(--gold);
  margin:20px 0;
}
.info{
  margin:20px 0;
  line-height:1.7;
}
.info .label{
  font-size:11px;
  letter-spacing:3px;
  color:#999078;
  text-transform:uppercase;
}
.info .value{
  font-size:17px;
  margin-top:5px;
}
.reveal{
  opacity:0;
  transform:translateY(22px);
  transition:opacity .8s ease,
    transform .8s ease;
}
.open .reveal{
  opacity:1;
  transform:translateY(0);
}
.open .reveal:nth-child(2){transition-delay:.4s}
.open .reveal:nth-child(3){transition-delay:.7s}
.open .reveal:nth-child(4){transition-delay:1s}
.open .reveal:nth-child(5){transition-delay:1.3s}
.open .reveal:nth-child(6){transition-delay:1.6s}
.actions{
  display:flex;
  justify-content:center;
  gap:10px;
  margin-top:20px;
  flex-wrap:wrap;
}
.actions button{padding:11px 19px}
.back{
  background:transparent;
  color:var(--olive);
}
.footer{
  position:absolute;
  bottom:5%;
  width:100%;
  text-align:center;
  font-size:13px;
  letter-spacing:1px;
  z-index:3;
}
@media(max-height:700px){
  .detail-content{top:20%}
  .info{margin:12px 0}
  .divider{margin:12px 0}
}
@media(prefers-reduced-motion:reduce){
  *,*:before,*:after{
    animation:none!important;
    transition:none!important;
  }
}
</style>
</head>
<body>
<main>
<div class="card" id="invitation">

<!-- FIRST PAGE -->
<section class="scene cover">
<svg class="art" viewBox="0 0 400 760"
 preserveAspectRatio="xMidYMid slice">

<defs>
  <linearGradient id="roof" x1="0" y1="0" x2="0" y2="1">
    <stop stop-color="#ad927b"/>
    <stop offset="1" stop-color="#766d5b"/>
  </linearGradient>
  <linearGradient id="dress" x1="0" y1="0" x2="1" y2="1">
    <stop stop-color="#fffdf7"/>
    <stop offset="1" stop-color="#d9d0c0"/>
  </linearGradient>
</defs>

<!-- Mountains -->
<path d="M0 580 Q75 505 135 555
 Q210 465 290 548 Q360 495 400 535
 V760 H0Z" fill="#c9cabb" opacity=".35"/>
<path d="M0 625 Q95 560 175 610
 Q260 545 400 615 V760 H0Z"
 fill="#b8bdac" opacity=".3"/>

<!-- Temple -->
<g opacity=".72">
  <path d="M155 570 Q270 495 410 520
  L410 545 Q265 535 155 590Z"
  fill="url(#roof)"/>
  <path d="M185 575 L185 740 M365 545 L365 740"
  stroke="#9d8a74" stroke-width="10"/>
  <path d="M200 610 H400"
  stroke="#ad9780" stroke-width="7"/>
  <path d="M200 660 H400"
  stroke="#ad9780" stroke-width="5"/>
  <path d="M230 575 V700 M330 550 V700"
  stroke="#a99a85" stroke-width="4"/>
</g>

<!-- Blossom branch -->
<g class="branch">
  <path d="M-20 5 Q90 50 145 18
   M30 35 Q55 95 100 110
   M65 32 Q95 65 160 70"
   fill="none" stroke="#8d8870"
   stroke-width="3"/>
  <g fill="#9eaa87">
    <ellipse cx="38" cy="23" rx="17" ry="6"
      transform="rotate(-25 38 23)"/>
    <ellipse cx="80" cy="42" rx="19" ry="6"
      transform="rotate(40 80 42)"/>
    <ellipse cx="94" cy="92" rx="16" ry="6"
      transform="rotate(-35 94 92)"/>
    <ellipse cx="139" cy="65" rx="17" ry="6"
      transform="rotate(30 139 65)"/>
  </g>
  <g fill="#fff6ed" stroke="#d8b6ab">
    <circle cx="43" cy="52" r="11"/>
    <circle cx="91" cy="26" r="10"/>
    <circle cx="119" cy="76" r="12"/>
    <circle cx="65" cy="102" r="9"/>
    <circle cx="156" cy="23" r="8"/>
  </g>
  <g fill="#d8a69d">
    <circle cx="43" cy="52" r="2.5"/>
    <circle cx="91" cy="26" r="2.5"/>
    <circle cx="119" cy="76" r="2.5"/>
    <circle cx="65" cy="102" r="2.5"/>
  </g>
</g>

<!-- Hanging lantern -->
<g transform="translate(55 85)">
  <g class="lantern">
    <path d="M78 -85 V0"
      stroke="#ae8e56" stroke-width="1.5"/>
    <path d="M58 10 Q78 -10 98 10
      L98 77 Q78 93 58 77Z"
      fill="#f2dfb8" stroke="#b28d52"
      stroke-width="2"/>
    <path d="M78 0 V90 M58 43 H98
      M65 8 Q78 40 65 80
      M91 8 Q78 40 91 80"
      stroke="#bd9a62" fill="none"/>
    <path d="M78 90 V120"
      stroke="#b28d52" stroke-width="2"/>
    <path d="M72 120 L78 145 L84 120"
      fill="#b28d52"/>
  </g>
</g>

<!-- Couple -->
<g transform="translate(100 485)">
  <!-- Groom -->
  <path d="M45 73 Q20 88 15 195
    H112 Q103 95 78 73Z"
    fill="#e5e3db" stroke="#a8a293"
    stroke-width="2"/>
  <path d="M40 75 L62 125 L85 75"
    fill="#fffdf7" stroke="#b2aa9c"/>
  <circle cx="62" cy="43" r="25"
    fill="#e9d0b8"/>
  <path d="M38 40 Q34 5 65 10
    Q93 12 86 43
    Q73 25 38 40Z"
    fill="#514d46"/>
  <path d="M57 53 Q63 58 70 52"
    stroke="#8b6f62" fill="none"/>

  <!-- Bride -->
  <path d="M105 85 Q75 125 65 210
    H205 Q195 120 153 85Z"
    fill="url(#dress)" stroke="#c5b9a8"
    stroke-width="2"/>
  <path d="M102 90 Q70 130 60 210
    M153 90 Q185 135 205 210"
    fill="none" stroke="#ddd2c2"
    stroke-width="3"/>
  <circle cx="128" cy="51" r="24"
    fill="#ecd1bb"/>
  <path d="M104 50 Q99 18 125 20
    Q151 18 153 49
    L148 68 Q141 45 143 35
    Q118 46 104 50Z"
    fill="#494640"/>
  <path d="M122 60 Q129 65 136 59"
    fill="none" stroke="#97776b"/>
  <path d="M98 83 Q125 75 156 84"
    stroke="#d2c4af" stroke-width="6"
    fill="none"/>
  <!-- Bouquet -->
  <g transform="translate(97 125)">
    <path d="M0 0 L20 42 M18 0 L20 42
      M32 0 L20 42"
      stroke="#7f9675" stroke-width="3"/>
    <g fill="#f5dfd7" stroke="#cdaaa0">
      <circle cx="0" cy="0" r="10"/>
      <circle cx="18" cy="-6" r="11"/>
      <circle cx="32" cy="3" r="10"/>
      <circle cx="14" cy="12" r="9"/>
    </g>
  </g>
</g>
</svg>

<div class="petals" id="petals"></div>

<div class="header">
  <div class="eyebrow">TRÂN TRỌNG KÍNH MỜI</div>
  <h1 class="heading">LỄ HẰNG THUẬN</h1>
  <div class="ornament">✧ ❀ ✧</div>
</div>

<div class="names">
  MATTEO <span>♡</span> HOÀ
</div>

<div class="open-button">
  <button onclick="openInvitation()">
    MỞ THIỆP &nbsp; ✧
  </button>
</div>
</section>

<!-- SECOND PAGE -->
<section class="scene details">
<svg class="art" viewBox="0 0 400 760"
 preserveAspectRatio="xMidYMid slice">
  <g opacity=".8">
    <path d="M-10 10 Q80 80 165 15
      M25 45 Q80 110 125 100"
      stroke="#8f9275" stroke-width="2"
      fill="none"/>
    <g fill="#a6b095">
      <ellipse cx="38" cy="28" rx="17" ry="6"
        transform="rotate(-35 38 28)"/>
      <ellipse cx="105" cy="43" rx="18" ry="6"
        transform="rotate(25 105 43)"/>
    </g>
    <g fill="#fff7ee" stroke="#d9bcb1">
      <circle cx="48" cy="55" r="12"/>
      <circle cx="96" cy="80" r="10"/>
      <circle cx="140" cy="24" r="9"/>
    </g>
  </g>

  <!-- Right lantern -->
  <g transform="translate(240 0)">
    <path d="M95 0 V65" stroke="#b99a67"/>
    <path d="M75 75 Q95 55 115 75
      V135 Q95 150 75 135Z"
      fill="#f3e0bb" stroke="#b99a67"
      stroke-width="2"/>
    <path d="M95 65 V150 M75 105 H115"
      stroke="#b99a67" fill="none"/>
    <path d="M95 150 V180"
      stroke="#b99a67" stroke-width="2"/>
  </g>

  <!-- Bottom foliage -->
  <path d="M0 735 Q100 675 200 725
    Q310 660 400 710 V760 H0Z"
    fill="#d7dccc" opacity=".6"/>
  <g fill="#aab59c">
    <ellipse cx="30" cy="715" rx="35" ry="9"
      transform="rotate(-35 30 715)"/>
    <ellipse cx="370" cy="715" rx="35" ry="9"
      transform="rotate(35 370 715)"/>
  </g>
</svg>

<div class="detail-content">
  <h2 class="reveal">LỄ HẰNG THUẬN</h2>

  <div class="subtitle reveal">
    MATTEO &amp; HOÀ
    <div class="divider">✧ ❀ ✧</div>
    TRÂN TRỌNG KÍNH MỜI QUÝ KHÁCH
  </div>

  <div class="info reveal">
    <div class="label">Ngày tổ chức</div>
    <div class="value" id="dateText"></div>
  </div>

  <div class="info reveal">
    <div class="label">Thời gian</div>
    <div class="value" id="timeText"></div>
  </div>

  <div class="info reveal">
    <div class="label">Địa điểm</div>
    <div class="value" id="venueText"></div>
    <div id="addressText"
      style="font-size:13px;margin-top:5px"></div>
  </div>

  <div class="actions reveal">
    <button id="mapButton" onclick="openMap()">
      ♧ &nbsp; CHỈ ĐƯỜNG
    </button>
    <button class="back" onclick="closeInvitation()">
      ← Quay lại
    </button>
  </div>
</div>

<div class="footer">
  Với tất cả yêu thương ♡
</div>
</section>

</div>
</main>

<script>
// EDIT YOUR WEDDING INFORMATION HERE
const INVITATION_DETAILS = {
  date: "Ngày cưới sẽ được cập nhật",
  time: "Thời gian sẽ được cập nhật",
  venue: "Địa điểm sẽ được cập nhật",
  address: "",
  googleMapsUrl: ""
};

const card = document.getElementById("invitation");

document.getElementById("dateText").textContent =
  INVITATION_DETAILS.date;
document.getElementById("timeText").textContent =
  INVITATION_DETAILS.time;
document.getElementById("venueText").textContent =
  INVITATION_DETAILS.venue;
document.getElementById("addressText").textContent =
  INVITATION_DETAILS.address;

function openInvitation(){
  card.classList.add("open");
}

function closeInvitation(){
  card.classList.remove("open");
}

function openMap(){
  if(INVITATION_DETAILS.googleMapsUrl){
    window.open(
      INVITATION_DETAILS.googleMapsUrl,
      "_blank",
      "noopener,noreferrer"
    );
  }else{
    alert("Đường dẫn bản đồ sẽ được cập nhật.");
  }
}

// Animated falling flower petals
const container=document.getElementById("petals");

for(let i=0;i<18;i++){
  const petal=document.createElement("span");
  petal.className="petal";
  petal.style.left=(Math.random()*100)+"%";
  petal.style.animationDuration=
    (8+Math.random()*9)+"s";
  petal.style.animationDelay=
    (-Math.random()*15)+"s";
  petal.style.opacity=.3+Math.random()*.5;
  container.appendChild(petal);
}

// Keyboard navigation
document.addEventListener("keydown",function(e){
  if(e.key==="ArrowRight")openInvitation();
  if(e.key==="ArrowLeft"||e.key==="Escape"){
    closeInvitation();
  }
});
</script>
</body>
</html>
